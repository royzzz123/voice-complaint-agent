# --- required for a real phone demo
GLM_API_KEY=                  # Z.ai key (z.ai → API Keys): per-turn moderation + extraction + reply
WEBHOOK_SECRET=               # long random string; Bolna sends it as Bearer token / custom-LLM key
ADMIN_TOKEN=                  # for /admin
PUBLIC_BASE_URL=              # public https URL of this server (cloudflared/ngrok/Render)
BOLNA_API_KEY=                # only for `npm run bolna:setup`
# BOLNA_PHONE_NUMBER_ID=      # optional: link inbound number during setup
# BOLNA_TELEPHONY=plivo       # plivo | twilio | exotel | vobiz (whichever provides your number)

# --- model
CF_API_TOKEN=                                   # Cloudflare token with Workers AI permission
CF_ACCOUNT_ID=                                  # Cloudflare dashboard → Account home → Account ID
# CF_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct   # backup model (~3s/turn)
# LLM_PROVIDER=cloudflare                       # cloudflare (default if CF_API_TOKEN set) | glm | claude
# GLM_MODEL=glm-5.3-flashx                     # fastest tested on Z.ai (~2.2s/turn)
# LLM_TIMEOUT_SEC=7                             # then try the next configured model
# GLM_BASE_URL=https://api.z.ai/api/paas/v4     # mainland-China accounts: https://open.bigmodel.cn/api/paas/v4
# ANTHROPIC_API_KEY=                            # only if LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-opus-5

# --- guardrails (defaults shown)
# ALLOWED_COUNTRY_CODES=+91
# CALLER_ALLOWLIST=+919800000000,+919800000001   # demo team numbers: never rate-limited
# MAX_CALLS_PER_HOUR=3
# MAX_CALLS_PER_DAY=6
# HOURLY_BLOCK_HOURS=24
# DAILY_BLOCK_HOURS=24
# MAX_FLAGGED_CALLS_PER_DAY=2
# FLAGGED_BLOCK_HOURS=168
# THREAT_BLOCK_HOURS=720
# REPEAT_BLOCK_MULTIPLIER=2
# OFF_TOPIC_STRIKES_TO_END=3
# ABUSE_STRIKES_TO_END=2
# MAX_CALL_SECONDS=600
# MAX_TURNS=30
# MAX_COMPLAINTS_PER_DAY=3
# MAX_CONCURRENT_CALLS=10

# --- existing web app mirror
# WEB_APP_BASE_URL=https://sebi-compliant-stt.vercel.app
# MIRROR_TO_WEB_APP=true
