<mxfile host="app.diagrams.net"><diagram id="biz" name="SwarComplaint — business overview"><mxGraphModel dx="1500" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="810" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SwarComplaint&lt;/b&gt; — an investor files a SEBI complaint with one phone call" style="fontFamily=Helvetica;text;html=1;fontSize=26;fontColor=#1B2A3A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="sub" value="No app, no forms, no typing. The investor speaks; the assistant prepares a complete, SCORES-ready complaint." style="fontFamily=Helvetica;text;html=1;fontSize=15;fontColor=#5B6B7B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="30" as="geometry"/></mxCell><mxCell id="s1" value="&lt;font style=&quot;font-size:40px&quot;&gt;📞&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#3B7BDB&quot;&gt;1. Investor calls&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dials the helpline&lt;br&gt;&lt;b&gt;080 6426 1747&lt;/b&gt;&lt;br&gt;from any phone&lt;br&gt;&lt;br&gt;Hindi, Hinglish or English" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#E8F1FF;strokeColor=#3B7BDB;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="250" as="geometry"/></mxCell><mxCell id="s2" value="&lt;font style=&quot;font-size:40px&quot;&gt;🛡️&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#E8912D&quot;&gt;2. Caller is checked&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Blocked and repeat&lt;br&gt;callers are stopped&lt;br&gt;&lt;b&gt;before the call&lt;br&gt;is answered&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#FFF4E5;strokeColor=#E8912D;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="250" height="250" as="geometry"/></mxCell><mxCell id="s3" value="&lt;font style=&quot;font-size:40px&quot;&gt;💬&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#2E9E5B&quot;&gt;3. Natural conversation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;The assistant listens&lt;br&gt;and asks &lt;b&gt;only for the&lt;br&gt;details that are missing&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#EAF7EE;strokeColor=#2E9E5B;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="250" height="250" as="geometry"/></mxCell><mxCell id="s4" value="&lt;font style=&quot;font-size:40px&quot;&gt;✅&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#7B4FD6&quot;&gt;4. Details confirmed&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;The complaint is&lt;br&gt;read back; the investor&lt;br&gt;&lt;b&gt;confirms it is correct&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#F3ECFF;strokeColor=#7B4FD6;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="250" height="250" as="geometry"/></mxCell><mxCell id="s5" value="&lt;font style=&quot;font-size:40px&quot;&gt;📄&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#1F5FBF&quot;&gt;5. Complaint registered&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;A &lt;b&gt;reference number&lt;/b&gt;&lt;br&gt;is given on the call&lt;br&gt;&lt;br&gt;Ready to file on SCORES" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#E8F1FF;strokeColor=#1F5FBF;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="250" height="250" as="geometry"/></mxCell><mxCell id="a0" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#9AA5B1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#9AA5B1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#9AA5B1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#9AA5B1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prot_head" value="&lt;b&gt;Built-in protection on every call&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;fontSize=18;fontColor=#1B2A3A;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="600" height="34" as="geometry"/></mxCell><mxCell id="p0" value="&lt;font style=&quot;font-size:26px&quot;&gt;🚫&lt;/font&gt;&lt;br&gt;Abuse, pranks and&lt;br&gt;off-topic calls are&lt;br&gt;warned, then ended" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#FFFFFF;strokeColor=#D5DCE3;align=center;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="335" height="110" as="geometry"/></mxCell><mxCell id="p1" value="&lt;font style=&quot;font-size:26px&quot;&gt;🔒&lt;/font&gt;&lt;br&gt;Spam numbers are&lt;br&gt;blocked automatically&lt;br&gt;(e.g. 4 calls in 1 hour)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#FFFFFF;strokeColor=#D5DCE3;align=center;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="460" width="335" height="110" as="geometry"/></mxCell><mxCell id="p2" value="&lt;font style=&quot;font-size:26px&quot;&gt;🙅&lt;/font&gt;&lt;br&gt;No investment advice;&lt;br&gt;never asks for OTP,&lt;br&gt;PIN or password" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#FFFFFF;strokeColor=#D5DCE3;align=center;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="460" width="335" height="110" as="geometry"/></mxCell><mxCell id="p3" value="&lt;font style=&quot;font-size:26px&quot;&gt;🧾&lt;/font&gt;&lt;br&gt;Every call is recorded,&lt;br&gt;with a transcript and&lt;br&gt;an audit trail" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#FFFFFF;strokeColor=#D5DCE3;align=center;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1105" y="460" width="335" height="110" as="geometry"/></mxCell><mxCell id="out_head" value="&lt;b&gt;What it delivers&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;fontSize=18;fontColor=#1B2A3A;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="600" height="34" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot; color=&quot;#1F5FBF&quot;&gt;1–5 min&lt;/font&gt;&lt;/b&gt;&lt;br&gt;to register a complaint" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#F5F8FC;strokeColor=#F5F8FC;align=center;spacingTop=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="335" height="100" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot; color=&quot;#1F5FBF&quot;&gt;≈ 2 sec&lt;/font&gt;&lt;/b&gt;&lt;br&gt;for the assistant to reply" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#F5F8FC;strokeColor=#F5F8FC;align=center;spacingTop=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="640" width="335" height="100" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot; color=&quot;#1F5FBF&quot;&gt;≈ ₹14&lt;/font&gt;&lt;/b&gt;&lt;br&gt;running cost of a&lt;br&gt;3-minute complaint" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#F5F8FC;strokeColor=#F5F8FC;align=center;spacingTop=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="640" width="335" height="100" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot; color=&quot;#1F5FBF&quot;&gt;Live&lt;/font&gt;&lt;/b&gt;&lt;br&gt;dashboard for the team:&lt;br&gt;calls, transcripts, complaints" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;verticalAlign=top;spacingTop=14;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#33414E;fillColor=#F5F8FC;strokeColor=#F5F8FC;align=center;spacingTop=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1105" y="640" width="335" height="100" as="geometry"/></mxCell><mxCell id="foot" value="SwarComplaint prepares the complaint. It does not replace the official SEBI SCORES portal." style="fontFamily=Helvetica;text;html=1;fontSize=12;fontColor=#8A97A5;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1400" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>