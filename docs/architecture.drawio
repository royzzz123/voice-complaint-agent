<mxfile host="app.diagrams.net">
  <diagram id="arch" name="SwarComplaint phone line">
    <mxGraphModel dx="2767" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="770" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="caller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;" value="📞 Investor&lt;br&gt;any Indian mobile,&lt;br&gt;Hindi / Hinglish / English" vertex="1">
          <mxGeometry height="90" width="140" x="-230" y="190" as="geometry" />
        </mxCell>
        <mxCell id="line" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontStyle=1;" value="Complaint helpline&lt;br&gt;080 6426 1747" vertex="1">
          <mxGeometry height="90" width="160" x="130" y="-20" as="geometry" />
        </mxCell>
        <mxCell id="g_voice" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;arcSize=3;fillColor=#EEF3FF;strokeColor=#5B7BD5;" value="Voice layer" vertex="1">
          <mxGeometry height="380" width="230" x="400" y="110" as="geometry" />
        </mxCell>
        <mxCell id="stt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B7BD5;" value="Speech → text&lt;br&gt;(Hindi model, handles&lt;br&gt;Hinglish + English)" vertex="1">
          <mxGeometry height="70" width="200" x="415" y="160" as="geometry" />
        </mxCell>
        <mxCell id="tts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B7BD5;" value="Text → speech&lt;br&gt;(female Hindi voice)" vertex="1">
          <mxGeometry height="70" width="200" x="415" y="255" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#5B7BD5;" value="Call control&lt;br&gt;• welcome + recording notice&lt;br&gt;• ends call on final line&lt;br&gt;• 15 s silence hang-up&lt;br&gt;• 10-minute limit" vertex="1">
          <mxGeometry height="120" width="200" x="415" y="350" as="geometry" />
        </mxCell>
        <mxCell id="g_engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;arcSize=3;fillColor=#EAF7EE;strokeColor=#2E8B57;" value="SwarComplaint engine" vertex="1">
          <mxGeometry height="560" width="560" x="670" y="40" as="geometry" />
        </mxCell>
        <mxCell id="screen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#2E8B57;" value="① Caller screening (before the call is answered)&lt;br&gt;• blocked numbers rejected   • more than 3 calls in 1 hour → blocked 24 h&lt;br&gt;• more than 6 calls in a day → blocked   • 2 misuse calls in a day → blocked 7 days&lt;br&gt;• hidden caller ID and non-Indian numbers rejected   • repeat blocks double in length" vertex="1">
          <mxGeometry height="105" width="520" x="690" y="90" as="geometry" />
        </mxCell>
        <mxCell id="guard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#2E8B57;" value="② Conversation guardrails&lt;br&gt;(every turn)&lt;br&gt;• abuse: warning, then call ends&lt;br&gt;• off-topic / prank: redirect,&lt;br&gt;  warning, then call ends&lt;br&gt;• threat: call ends + block&lt;br&gt;• prompt injection refused&lt;br&gt;• distress: helpline, no penalty&lt;br&gt;• no advice, no OTP / PIN" vertex="1">
          <mxGeometry height="205" width="250" x="690" y="210" as="geometry" />
        </mxCell>
        <mxCell id="ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#2E8B57;" value="③ Understanding (language model)&lt;br&gt;• classifies each turn&lt;br&gt;• extracts SCORES fields:&lt;br&gt;  name, entity, issue, amount,&lt;br&gt;  date, prior complaint, refs&lt;br&gt;• writes the next question&lt;br&gt;• safety check on every reply&lt;br&gt;• backup model + keyword fallback" vertex="1">
          <mxGeometry height="205" width="250" x="960" y="210" as="geometry" />
        </mxCell>
        <mxCell id="register" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#2E8B57;" value="④ Complaint registration&lt;br&gt;• entity checked against SEBI-regulated list&lt;br&gt;• caller-ID mobile confirmed, not re-typed&lt;br&gt;• details read back, caller says yes&lt;br&gt;• reference number SWR-xxxxxx spoken to the caller&lt;br&gt;• same entity from the same number within 24 h → duplicate, not filed again&lt;br&gt;• maximum 3 complaints per number per day" vertex="1">
          <mxGeometry height="150" width="520" x="690" y="430" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fontSize=12;fillColor=#FFF8D6;strokeColor=#B8860B;fontStyle=0;" value="Complaint store&lt;br&gt;&lt;br&gt;calls + transcripts&lt;br&gt;blocked numbers&lt;br&gt;complaints&lt;br&gt;audit log (masked)" vertex="1">
          <mxGeometry height="150" width="200" x="1280" y="120" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#333333;" value="Admin dashboard&lt;br&gt;• live calls + transcripts&lt;br&gt;• block / unblock numbers&lt;br&gt;• registered complaints&lt;br&gt;• test console" vertex="1">
          <mxGeometry height="120" width="200" x="1280" y="320" as="geometry" />
        </mxCell>
        <mxCell id="officer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;" value="👤 Grievance officer" vertex="1">
          <mxGeometry height="70" width="200" x="1280" y="490" as="geometry" />
        </mxCell>
        <mxCell id="scores" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontColor=#555555;" value="SCORES filing&lt;br&gt;(complaint + reference)" vertex="1">
          <mxGeometry height="70" width="200" x="1280" y="600" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeColor=#CCCCCC;fillColor=#FFFFFF;" value="HOW ONE CALL FLOWS&lt;br&gt;1. The investor dials the helpline. Before the call is answered, the engine screens the number (①).   2. The voice layer plays the welcome message and changes each answer into text.   3. For each turn, the engine applies the guardrails (②), understands the answer and finds the missing details (③).   4. When all details are known, the engine reads them back. After the caller says yes, it registers the complaint and gives the reference number (④).   5. Everything is saved in the complaint store and shows live in the admin dashboard." vertex="1">
          <mxGeometry height="110" width="1210" x="20" y="630" as="geometry" />
        </mxCell>
