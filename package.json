{
  "name": "swarcomplaint-phone-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telephony layer for SwarComplaint: callers dial in to raise SEBI/SCORES complaints, with caller guardrails",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "bolna:setup": "tsx --env-file-if-exists=.env scripts/setup-bolna.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
